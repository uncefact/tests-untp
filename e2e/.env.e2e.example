# =============================================================================
# E2E Test Environment Variables
# =============================================================================
#
# Copy this file to .env.e2e and adjust values for your deployment.
# All variables have sensible defaults for the local Docker Compose setup.
#
# The test runner needs network access to:
#   - The RI application (CYPRESS_BASE_URL)
#   - The identity provider (E2E_IDP_BASE_URL) for authentication flows
#   - PostgreSQL (E2E_DB_*) for test setup/cleanup
#
# Service URLs (VCKit, Storage) are RI-internal — the RI uses them to reach
# its dependent services. The test runner does not call them directly.

# =============================================================================
# RI Application
# =============================================================================

# Base URL of the Reference Implementation
# CYPRESS_BASE_URL=http://localhost:3003

# =============================================================================
# Identity Provider (Authentication)
# =============================================================================
#
# Supports "keycloak" (default) and "zitadel".
# The login flow adapts automatically based on the provider.

# IDP type: "keycloak" or "zitadel"
# E2E_IDP_PROVIDER=keycloak

# IDP server URL
# E2E_IDP_BASE_URL=http://localhost:8081

# Realm name (Keycloak only; ignored for Zitadel)
# E2E_IDP_REALM=ri-e2e

# OIDC client for the RI application
# E2E_IDP_CLIENT_ID=ri-app-e2e
# E2E_IDP_CLIENT_SECRET=e2e-test-secret

# Zitadel project ID (audience claim) — required for Zitadel only.
# Used to request the correct scopes when fetching service account tokens.
# E2E_IDP_AUDIENCE=

# =============================================================================
# Test Users
# =============================================================================
#
# Prerequisites:
#   - Primary user must exist in the IDP with email and password
#   - Second user must exist in the IDP with same password as primary user
#   - Both users must be in the same IDP group (for closed-mode tests)

# Primary test user
# E2E_USER_EMAIL=e2e-admin@test.local
# E2E_USER_PASSWORD=E2eTest123!

# Second test user (used by closed-mode tenant resolution tests)
# E2E_USER2_EMAIL=e2e-user@test.local

# =============================================================================
# Service Accounts
# =============================================================================
#
# Prerequisites:
#   - Two IDP clients with client_credentials grant
#   - SA1 must be in group alpha, SA2 in group beta (for closed-mode tests)

# Service account 1
# E2E_SA1_CLIENT_ID=ri-service-account-e2e
# E2E_SA1_CLIENT_SECRET=e2e-service-account-secret

# Service account 2
# E2E_SA2_CLIENT_ID=ri-service-account-e2e-2
# E2E_SA2_CLIENT_SECRET=e2e-service-account-secret-2

# =============================================================================
# RI-Internal Service URLs
# =============================================================================
#
# These URLs are used by the RI to reach its dependent services.
# They are passed into service instance configs during test setup.
# The test runner does NOT call these URLs directly.

# VCKit (verifiable credential service)
# E2E_VCKIT_BASE_URL=http://vckit-api:3332
# E2E_VCKIT_API_KEY=test123

# Storage service
# E2E_STORAGE_BASE_URL=http://storage-service:3334
# E2E_STORAGE_API_KEY=test123
# E2E_STORAGE_API_VERSION=3.1.0
# E2E_STORAGE_PUBLIC_BUCKET=public-data
# E2E_STORAGE_PRIVATE_BUCKET=private-data

# =============================================================================
# Test Organisation
# =============================================================================

# Tenant ID for the test organisation (created by seedTestOrg task)
# E2E_TEST_ORG_ID=e2e-test-org

# Tenant mode: "open" (default) or "closed"
# In closed mode, tenants are auto-provisioned from IDP groups.
# seedTestOrg will find the existing tenant instead of creating one.
# E2E_TENANT_MODE=open

# =============================================================================
# Closed-Mode Groups
# =============================================================================
#
# IDP group paths used for closed-mode tenant isolation tests.
# SA1 must be in GROUP_ALPHA, SA2 in GROUP_BETA.

# E2E_GROUP_ALPHA=/e2e-org-alpha
# E2E_GROUP_BETA=/e2e-org-beta

# =============================================================================
# UNTP Playground (Optional)
# =============================================================================
#
# Set this to enable playground tests. Leave empty to skip them.

# E2E_PLAYGROUND_BASE_URL=http://localhost:4000

# =============================================================================
# Database Connection
# =============================================================================
#
# Direct PostgreSQL connection for test setup/cleanup tasks.

# E2E_DB_HOST=localhost
# E2E_DB_PORT=5433
# E2E_DB_USER=ri-postgres
# E2E_DB_PASSWORD=ri-postgres
# E2E_DB_NAME=ri
