{
  "name": "reference-implementation",
  "version": "0.2.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/*/e2e"
    ],
    "nohoist": [
      "**/@storybook/**",
      "**/storybook",
      "reference-implementation-e2e/cypress",
      "reference-implementation-e2e/cypress/**"
    ]
  },
  "scripts": {
    "start": "cd packages/reference-implementation && yarn dev",
    "start:e2e-test": "cd packages/reference-implementation && yarn start",
    "start:untp-playground": "cd packages/untp-playground && PORT=4001 yarn dev",
    "start:e2e-dependencies": "docker compose -f docker-compose.e2e.yml up -d --build",
    "stop:e2e-dependencies": "docker compose -f docker-compose.e2e.yml down",
    "build": "yarn build:utils && yarn build:services && yarn build:components && yarn build:ri && yarn build:playground",
    "build:utils": "cd packages/untp-utils && yarn run build",
    "build:services": "cd packages/services && yarn run build",
    "build:components": "cd packages/components && yarn run build",
    "build:ri": "cd packages/reference-implementation && yarn run build",
    "build:playground": "cd packages/untp-playground && yarn run build",
    "build-clean": "rimraf --glob ./yarn.lock ./node_modules ./packages/*/tsconfig.tsbuildinfo ./packages/*/build ./packages/*/node_modules",
    "test": "lerna exec -- yarn jest",
    "test:coverage": "lerna exec -- yarn jest --coverage && rm -rf coverage && istanbul-merge --out coverage/coverage-final.json packages/*/coverage/coverage-final.json && nyc report --temp-dir=./coverage --reporter=html --reporter=json-summary",
    "test:components": "cd packages/components && yarn run test",
    "test:utils": "cd packages/untp-utils && yarn run test",
    "test:services": "cd packages/services && yarn run test",
    "test:reference-implementation": "cd packages/reference-implementation && yarn run test",
    "test:untp-playground": "cd packages/untp-playground && yarn run test",
    "test:e2e:ri": "yarn workspace reference-implementation-e2e test:e2e",
    "test:e2e:ri:open": "yarn workspace reference-implementation-e2e test:e2e:open",
    "test:e2e:ri:closed": "yarn workspace reference-implementation-e2e test:e2e:closed",
    "test:e2e:ri:open-ui": "yarn workspace reference-implementation-e2e cypress:open",
    "test:e2e:playground": "yarn workspace untp-playground-e2e test:e2e",
    "test:e2e:playground:open-ui": "yarn workspace untp-playground-e2e cypress:open",
    "storybook:components": "cd packages/components && yarn run storybook",
    "storybook:reference-implementation": "cd packages/reference-implementation && yarn run storybook",
    "upgrade:packages": "yarn -r --stream upgrade --latest",
    "version": "lerna version",
    "changeset": "changeset",
    "prepare": "husky install",
    "lint:check": "cross-env NODE_OPTIONS=--max-old-space-size=8192 yarn eslint packages && yarn --cwd packages/reference-implementation lint",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=8192 yarn eslint packages --fix",
    "format:check": "prettier --check \"packages/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:fix": "prettier --write \"packages/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "release:doc": "node scripts/release-doc.js",
    "generate-version-mapping": "node documentation/version-mapping/script.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@jest/globals": "^29.7.0",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "29.5.11",
    "@types/node": "20.10.6",
    "@types/uuid": "^9.0.7",
    "cross-env": "^7.0.3",
    "cypress": "^13.16.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.0",
    "jest": "29.7.0",
    "jest-config": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-environment-node": "29.7.0",
    "lerna": "8.0.1",
    "lerna-changelog": "2.2.0",
    "lint-staged": "^15.2.0",
    "prettier": "3.1.1",
    "pretty-quick": "3.1.3",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "turbo": "^2.9.12",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "resolutions": {
    "@types/eslint": "^8.4.6",
    "eslint": "^8.57.1",
    "eslint-visitor-keys": "^4.2.1",
    "strip-ansi": "6.0.0",
    "string-width": "4.0.0",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@uncefact/vckit-core-types": "1.0.0-next.61"
  },
  "engines": {
    "node": ">= 20.12.2"
  },
  "dependencies": {
    "istanbul-merge": "2.0.0",
    "nyc": "17.1.0",
    "rimraf": "^5.0.5"
  },
  "lint-staged": {
    "packages/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "packages/**/*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
