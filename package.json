{
  "name": "reference-implementation",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "pnpm --filter untp-reference-implementation dev",
    "start:e2e-test": "pnpm --filter untp-reference-implementation start",
    "start:untp-playground": "PORT=4001 pnpm --filter untp-playground dev",
    "start:e2e-dependencies": "docker compose -f docker-compose.e2e.yml up -d --build",
    "stop:e2e-dependencies": "docker compose -f docker-compose.e2e.yml down",
    "build": "pnpm run build:utils && pnpm run build:services && pnpm run build:components && pnpm run build:ri && pnpm run build:playground",
    "build:utils": "pnpm --filter @uncefact/untp-utils run build",
    "build:services": "pnpm --filter @uncefact/untp-ri-services run build",
    "build:components": "pnpm --filter @reference-implementation/components run build",
    "build:ri": "pnpm --filter untp-reference-implementation run build",
    "build:playground": "pnpm --filter untp-playground run build",
    "build-clean": "rimraf --glob ./node_modules ./packages/*/tsconfig.tsbuildinfo ./packages/*/build ./packages/*/node_modules",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:coverage": "pnpm -r --workspace-concurrency=1 run test --coverage && rm -rf coverage && istanbul-merge --out coverage/coverage-final.json packages/*/coverage/coverage-final.json && nyc report --temp-dir=./coverage --reporter=html --reporter=json-summary",
    "test:components": "pnpm --filter @reference-implementation/components run test",
    "test:utils": "pnpm --filter @uncefact/untp-utils run test",
    "test:services": "pnpm --filter @uncefact/untp-ri-services run test",
    "test:reference-implementation": "pnpm --filter untp-reference-implementation run test",
    "test:untp-playground": "pnpm --filter untp-playground run test",
    "test:e2e:ri": "pnpm --filter reference-implementation-e2e test:e2e",
    "test:e2e:ri:open": "pnpm --filter reference-implementation-e2e test:e2e:open",
    "test:e2e:ri:closed": "pnpm --filter reference-implementation-e2e test:e2e:closed",
    "test:e2e:ri:open-ui": "pnpm --filter reference-implementation-e2e cypress:open",
    "test:e2e:playground": "pnpm --filter untp-playground-e2e test:e2e",
    "test:e2e:playground:open-ui": "pnpm --filter untp-playground-e2e cypress:open",
    "storybook:components": "pnpm --filter @reference-implementation/components run storybook",
    "storybook:reference-implementation": "pnpm --filter untp-reference-implementation run storybook",
    "changeset": "changeset",
    "prepare": "husky install",
    "lint:check": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint packages",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint packages --fix",
    "format:check": "prettier --check \"packages/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:fix": "prettier --write \"packages/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "release:doc": "node scripts/release-doc.js",
    "generate-version-mapping": "node documentation/version-mapping/script.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "20.10.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "3.1.1",
    "turbo": "^2.9.12",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "@types/eslint": "^8.4.6",
      "eslint": "^8.57.1",
      "eslint-visitor-keys": "^4.2.1",
      "dompurify@^3.0.0": "^3.4.3",
      "protobufjs@^7.0.0": "^7.5.6",
      "protobufjs@^8.0.0": "^8.0.2",
      "undici@^6.0.0": "^6.24.0",
      "serialize-javascript@^7.0.0": "^7.0.5",
      "path-to-regexp@^0.1.0": "^0.1.13",
      "path-to-regexp@^2.0.0": "^3.3.0",
      "node-forge@^1.0.0": "^1.4.0",
      "js-yaml@^3.0.0": "^3.14.2",
      "js-yaml@^4.0.0": "^4.1.1",
      "lodash-es@^4.0.0": "^4.18.1",
      "lodash@^4.0.0": "^4.18.1",
      "tar@^7.0.0": "^7.5.11",
      "minimatch@^3.0.0": "^3.1.4",
      "minimatch@^9.0.0": "^9.0.7",
      "picomatch@^2.0.0": "^2.3.2",
      "picomatch@^3.0.0": "^3.0.2",
      "brace-expansion@^1.0.0": "^1.1.13",
      "brace-expansion@^2.0.0": "^2.0.3",
      "webpack@^5.0.0": "^5.104.1",
      "axios@^1.0.0": "^1.15.2",
      "handlebars@^4.0.0": "^4.7.9",
      "qs@^6.0.0": "^6.14.2",
      "http-proxy-middleware@^2.0.0": "^2.0.9",
      "diff@^5.0.0": "^5.2.2",
      "diff@^6.0.0": "^8.0.3",
      "diff@^7.0.0": "^8.0.3",
      "fast-xml-parser@^4.0.0": "^4.5.5"
    }
  },
  "engines": {
    "node": ">= 22.22.2"
  },
  "dependencies": {
    "istanbul-merge": "2.0.0",
    "nyc": "17.1.0",
    "rimraf": "^5.0.5"
  },
  "lint-staged": {
    "packages/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "packages/**/*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.4"
}
