# Verification service used by /api/verify (POST credential -> VC verification result).
# When unset, /api/verify responds with HTTP 503 and the "Verification" step on
# every uploaded credential will fail.
VERIFICATION_SERVICE_URL=https://vckit.untp.showthething.com/agent/routeVerificationCredential
VERIFICATION_SERVICE_TOKEN=test123

# Where the playground sends users when a server-side error appears to be
# unrecoverable from their side (e.g. schema service timeout). Defaults to the
# UNTP repository's issues page when unset.
NEXT_PUBLIC_SUPPORT_URL=https://github.com/uncefact/tests-untp/issues

# Public URL of THIS playground deployment. Surfaced in the HTML conformance
# report footer ('Generated by UNTP Playground' link). The URL differs between
# environments (preview, staging, production), so there is no canonical
# default. Each deploy environment must set this to its own origin; when
# unset, the footer renders as plain text with no link.
# NEXT_PUBLIC_PLAYGROUND_URL=https://example.com

# Optional: base path and asset prefix when serving the playground behind a path
# prefix (e.g. behind a reverse proxy at /playground). Leave unset for local dev.
# NEXT_PUBLIC_BASE_PATH=/playground
# NEXT_PUBLIC_ASSET_PREFIX=/playground
