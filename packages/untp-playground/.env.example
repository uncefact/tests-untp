# Verification service used by /api/verify (POST credential -> VC verification result).
# When unset, /api/verify responds with HTTP 503 and the "Verification" step on
# every uploaded credential will fail.
VERIFICATION_SERVICE_URL=https://vckit.untp.showthething.com/agent/routeVerificationCredential
VERIFICATION_SERVICE_TOKEN=test123

# Where the playground sends users when a server-side error appears to be
# unrecoverable from their side (e.g. schema service timeout). Defaults to the
# UNTP repository's issues page when unset.
NEXT_PUBLIC_SUPPORT_URL=https://github.com/uncefact/tests-untp/issues

# Public URL of THIS playground deployment. Surfaced in the HTML conformance
# report footer ('Generated by UNTP Playground' link). The URL differs between
# environments (preview, staging, production), so there is no canonical
# default. Each deploy environment must set this to its own origin; when
# unset, the footer renders as plain text with no link.
# NEXT_PUBLIC_PLAYGROUND_URL=https://example.com

# Brand prefix used in the report title, eyebrow, and footer ('UNTP
# Conformance Report', 'Generated by UNTP Playground'). Extension deployments
# can rebrand all three surfaces by setting this. Defaults to 'UNTP'.
# NEXT_PUBLIC_REPORT_NAME=UNTP

# Build version of this playground UI. Shown in the header chip next to the
# title. Defaults to the playground's own package.json version; override at
# build time if your release process tags differently.
# NEXT_PUBLIC_PLAYGROUND_VERSION=0.2.2

# Version of the code actually running the conformance checks. Shown on the
# report's 'Test runner' line. Today the runner is bundled into the
# playground, so this defaults to the playground's package.json. When the
# runner is swapped for the standalone untp-test-suite library, set this to
# that library's version so the report declares what produced it accurately.
# NEXT_PUBLIC_TEST_SUITE_VERSION=0.2.2

# Canonical home of the test runner; wraps the report's 'Test runner' line
# in a link. Defaults to this repository while the runner lives here. Update
# when the runner moves elsewhere (own repo, npm page, project site). Not
# required to be a GitHub URL.
# NEXT_PUBLIC_TEST_SUITE_URL=https://github.com/uncefact/tests-untp

# Optional: base path and asset prefix when serving the playground behind a path
# prefix (e.g. behind a reverse proxy at /playground). Leave unset for local dev.
# NEXT_PUBLIC_BASE_PATH=/playground
# NEXT_PUBLIC_ASSET_PREFIX=/playground

# Where the "How credential links are identified" link on a link set card points. Set to the
# deployed documentation site's page for this playground version; defaults to the page in the
# repository.
# NEXT_PUBLIC_CREDENTIAL_LINKS_DOCS_URL=https://example.com/playground/docs/identifying-untp-credential-links
