<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{credentialSubject.reportName}} · Conformance Report</title>
  <style>
    :root {
      --ink: hsl(0 0% 8%);
      --ink-2: hsl(0 0% 30%);
      --ink-3: hsl(0 0% 46%);
      --ink-4: hsl(0 0% 64%);
      --line: hsl(0 0% 90%);
      --line-2: hsl(0 0% 95%);
      --bg: hsl(0 0% 100%);
      --bg-2: hsl(0 0% 98.5%);
      --ok: hsl(142 60% 32%);
      --ok-bg: hsl(143 55% 96%);
      --fail: hsl(0 70% 42%);
      --fail-bg: hsl(0 75% 97%);
      --sans: "Geist", "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif;
      --mono: "Geist Mono", "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.55;
      font-feature-settings: "ss01", "cv11";
      -webkit-font-smoothing: antialiased;
      word-break: break-word;
    }
    a { color: inherit; text-underline-offset: 2px; text-decoration-color: var(--ink-4); }
    a:hover { text-decoration-color: var(--ink-2); }

    .page {
      max-width: 880px;
      margin: 0 auto;
      padding: 56px 40px 80px;
    }

    /* Header */
    .rh-eyebrow {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-3);
      margin: 0 0 12px;
    }
    .rh-title {
      font-size: 32px;
      font-weight: 600;
      letter-spacing: -0.018em;
      line-height: 1.15;
      margin: 0 0 24px;
    }
    .rh-meta {
      display: grid;
      grid-template-columns: max-content 1fr;
      column-gap: 24px;
      row-gap: 6px;
      padding: 20px 0 24px;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      margin: 0 0 48px;
    }
    .rh-meta dt {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--ink-3);
      margin: 0;
      align-self: baseline;
    }
    .rh-meta dd {
      font-size: 14px;
      color: var(--ink);
      margin: 0;
    }
    .rh-meta dd .mono { font-family: var(--mono); font-size: 12.5px; color: var(--ink-2); }

    /* Section heading */
    .section-h {
      font-size: 11px;
      font-family: var(--mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-3);
      margin: 56px 0 20px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }
    .section-h:first-of-type { margin-top: 0; }
    .section-h .count { color: var(--ink-4); }

    /* Result block */
    .result {
      padding: 24px 0 28px;
      border-bottom: 1px solid var(--line);
    }
    .result:last-of-type { border-bottom: none; }
    .result-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 16px;
    }
    .result-name {
      font-size: 18px;
      font-weight: 600;
      letter-spacing: -0.01em;
      margin: 0;
    }
    .result-name .ver {
      color: var(--ink-3);
      font-weight: 500;
      margin-left: 6px;
      font-variant-numeric: tabular-nums;
    }
    .result-sub {
      color: var(--ink-3);
      font-size: 13px;
      margin: 4px 0 0;
    }
    .result-source {
      color: var(--ink-3);
      font-family: var(--mono);
      font-size: 12px;
      margin: 6px 0 0;
      word-break: break-all;
    }
    .result-source a { color: var(--ink-2); }

    /* Status pill */
    .pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 999px;
      flex-shrink: 0;
    }
    .pill.success { color: var(--ok); background: var(--ok-bg); }
    .pill.failure { color: var(--fail); background: var(--fail-bg); }
    .pill::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: currentColor;
    }

    /* Step list */
    .steps { margin: 0; padding: 0; list-style: none; }
    .step {
      display: grid;
      grid-template-columns: 16px 1fr auto;
      column-gap: 12px;
      align-items: baseline;
      padding: 10px 0;
      border-top: 1px dashed var(--line);
    }
    .step:first-child { border-top: none; }
    .step-mark {
      font-family: var(--mono);
      font-size: 13px;
      line-height: 1;
      color: var(--ink-4);
    }
    .step.success .step-mark { color: var(--ok); }
    .step.failure .step-mark { color: var(--fail); }
    .step-name {
      font-size: 14px;
      color: var(--ink);
    }
    .step-status {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .step.success .step-status { color: var(--ok); }
    .step.failure .step-status { color: var(--fail); }

    /* Errors */
    .errors {
      grid-column: 2 / -1;
      margin: 8px 0 4px;
      padding: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .err {
      padding: 10px 12px 10px 14px;
      background: var(--fail-bg);
      border-left: 2px solid var(--fail);
      border-radius: 4px;
      font-size: 13px;
    }
    .err-msg {
      color: var(--fail);
      margin: 0 0 4px;
      font-weight: 500;
    }
    .err-detail {
      margin: 0;
      padding: 2px 0 0;
      list-style: none;
    }
    .err-detail li {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--ink-2);
      padding: 1px 0;
      word-break: break-all;
    }

    /* Footer */
    .rh-footer {
      margin-top: 64px;
      padding-top: 20px;
      border-top: 1px solid var(--line);
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      color: var(--ink-3);
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      flex-wrap: wrap;
    }
    .rh-footer a { color: var(--ink-2); }

    /* Print */
    @media print {
      body { background: #fff; }
      .page { padding: 24px; max-width: none; }
      .result { break-inside: avoid; }
      .step { break-inside: avoid; }
      a { color: inherit; text-decoration: none; }
      .section-h, .result, .step { border-color: #ccc; }
    }

    /* Small viewports */
    @media (max-width: 640px) {
      .page { padding: 32px 20px 56px; }
      .rh-title { font-size: 24px; }
      .rh-meta { grid-template-columns: 1fr; row-gap: 4px; }
      .rh-meta dd { padding-bottom: 8px; border-bottom: 1px solid var(--line-2); }
      .rh-meta dd:last-child { border-bottom: none; }
      .result-head { flex-direction: column; gap: 8px; }
      .step { grid-template-columns: 16px 1fr; }
      .step-status { grid-column: 2 / -1; padding-top: 2px; }
    }
  </style>
</head>

<body>
  <main class="page">

    <header>
      <p class="rh-eyebrow">{{credentialSubject.reportName}} Conformance Report</p>
      <h1 class="rh-title">{{credentialSubject.implementation.name}}</h1>
      <dl class="rh-meta">
        <dt>Date</dt>
        <dd>{{formatDate credentialSubject.date}}</dd>

        <dt>Test runner</dt>
        <dd>
          {{credentialSubject.testSuite.runner}}
          <span class="mono">v{{credentialSubject.testSuite.version}}</span>
        </dd>
      </dl>
    </header>

    {{#if credentialSubject.verifiableCredentials}}
      <h2 class="section-h">
        <span>Verifiable Credentials</span>
      </h2>

      {{#each credentialSubject.verifiableCredentials}}
        <article class="result">
          <header class="result-head">
            <div>
              {{#if extension}}
                <h3 class="result-name">
                  {{extension.type}}<span class="ver">v{{extension.version}}</span>
                </h3>
                <p class="result-sub">Extension of {{core.type}} v{{core.version}}</p>
              {{else}}
                <h3 class="result-name">
                  {{core.type}}<span class="ver">v{{core.version}}</span>
                </h3>
              {{/if}}
              {{#if source}}
                {{#if source.url}}
                  <p class="result-source">source: <a href="{{source.url}}" target="_blank" rel="noopener noreferrer">{{source.url}}</a></p>
                {{else}}
                  <p class="result-source">source: {{source.filename}}</p>
                {{/if}}
              {{/if}}
            </div>
            {{#if overallStatus}}
              <span class="pill {{overallStatus}}">{{overallStatus}}</span>
            {{/if}}
          </header>

          <ul class="steps">
            {{#each core.steps}}
              <li class="step {{status}}">
                <span class="step-mark">{{#if (eq status "success")}}✓{{else}}{{#if (eq status "failure")}}✕{{else}}·{{/if}}{{/if}}</span>
                <span class="step-name">{{name}}</span>
                <span class="step-status">{{status}}</span>
                {{#if details.errors}}
                  <ul class="errors">
                    {{#each details.errors}}
                      <li class="err">
                        <p class="err-msg">{{message}}</p>
                        {{#if params.allowedValue}}
                          <ul class="err-detail">
                            <li>allowed: {{params.allowedValue}}</li>
                          </ul>
                        {{/if}}
                        {{#if params.allowedValues}}
                          <ul class="err-detail">
                            {{#each params.allowedValues}}<li>allowed: {{this}}</li>{{/each}}
                          </ul>
                        {{/if}}
                        {{#if params.additionalProperty}}
                          <ul class="err-detail">
                            <li>unexpected: {{params.additionalProperty}}</li>
                          </ul>
                        {{/if}}
                      </li>
                    {{/each}}
                  </ul>
                {{/if}}
              </li>
            {{/each}}

            {{#if extension}}
              {{#each extension.steps}}
                <li class="step {{status}}">
                  <span class="step-mark">{{#if (eq status "success")}}✓{{else}}{{#if (eq status "failure")}}✕{{else}}·{{/if}}{{/if}}</span>
                  <span class="step-name">{{name}}</span>
                  <span class="step-status">{{status}}</span>
                  {{#if details.errors}}
                    <ul class="errors">
                      {{#each details.errors}}
                        <li class="err">
                          <p class="err-msg">{{message}}</p>
                          {{#if params.allowedValue}}<ul class="err-detail"><li>allowed: {{params.allowedValue}}</li></ul>{{/if}}
                          {{#if params.allowedValues}}<ul class="err-detail">{{#each params.allowedValues}}<li>allowed: {{this}}</li>{{/each}}</ul>{{/if}}
                          {{#if params.additionalProperty}}<ul class="err-detail"><li>unexpected: {{params.additionalProperty}}</li></ul>{{/if}}
                        </li>
                      {{/each}}
                    </ul>
                  {{/if}}
                </li>
              {{/each}}
            {{/if}}
          </ul>
        </article>
      {{/each}}
    {{/if}}

    {{#if credentialSubject.conformitySchemeResults}}
      <h2 class="section-h">
        <span>Conformity Schemes</span>
      </h2>

      {{#each credentialSubject.conformitySchemeResults}}
        <article class="result">
          <header class="result-head">
            <div>
              {{#if name}}
                <h3 class="result-name">{{name}}</h3>
                <p class="result-sub">{{type}} v{{version}}</p>
              {{else}}
                <h3 class="result-name">{{type}}<span class="ver">v{{version}}</span></h3>
              {{/if}}
              {{#if source}}
                {{#if source.url}}
                  <p class="result-source">source: <a href="{{source.url}}" target="_blank" rel="noopener noreferrer">{{source.url}}</a></p>
                {{else}}
                  <p class="result-source">source: {{source.filename}}</p>
                {{/if}}
              {{/if}}
            </div>
            {{#if overallStatus}}
              <span class="pill {{overallStatus}}">{{overallStatus}}</span>
            {{/if}}
          </header>

          <ul class="steps">
            {{#each steps}}
              <li class="step {{status}}">
                <span class="step-mark">{{#if (eq status "success")}}✓{{else}}{{#if (eq status "failure")}}✕{{else}}·{{/if}}{{/if}}</span>
                <span class="step-name">{{name}}</span>
                <span class="step-status">{{status}}</span>
                {{#if details.errors}}
                  <ul class="errors">
                    {{#each details.errors}}
                      <li class="err">
                        <p class="err-msg">{{message}}</p>
                      </li>
                    {{/each}}
                  </ul>
                {{/if}}
              </li>
            {{/each}}
          </ul>
        </article>
      {{/each}}
    {{/if}}

    <footer class="rh-footer">
      <span>Generated by
        {{#if credentialSubject.playgroundUrl}}
          <a href="{{credentialSubject.playgroundUrl}}" target="_blank" rel="noopener noreferrer">{{credentialSubject.reportName}} Playground</a>
        {{else}}
          {{credentialSubject.reportName}} Playground
        {{/if}}
      </span>
      <span>
        {{#if credentialSubject.testSuite.url}}
          <a href="{{credentialSubject.testSuite.url}}" target="_blank" rel="noopener noreferrer">{{credentialSubject.testSuite.runner}}</a>
        {{else}}
          {{credentialSubject.testSuite.runner}}
        {{/if}}
        · v{{credentialSubject.testSuite.version}}
      </span>
    </footer>

  </main>
</body>

</html>
