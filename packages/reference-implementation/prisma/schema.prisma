generator client {
  provider      = "prisma-client-js"
  output        = "../src/lib/prisma/generated"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("RI_DATABASE_URL")
}

enum DidType {
  DEFAULT
  MANAGED
  SELF_MANAGED
}

enum DidMethod {
  DID_WEB
  DID_WEB_VH
}

enum DidStatus {
  ACTIVE
  INACTIVE
  VERIFIED
  UNVERIFIED
  VERIFICATION_FAILED
}

enum CredentialDetailsStatus {
  EXTRACTED
  EXTRACTION_PENDING
  EXTRACTION_FAILED
}

/// What an idempotency claim guards (#954, ADR-051). A claim is scoped by
/// tenant, operation and key, so one key may guard two operations
/// independently. Adding an operation is a migration, which is deliberate:
/// the value is written by code, never by a caller.
enum IdempotencyOperation {
  CREDENTIAL_ISSUE
  /// Registering a credential received from a third party (#955). Declared
  /// with the first operation because the scoping rule (one key may guard two
  /// operations independently) is only testable with two values.
  LIBRARY_REGISTER
}

/// Why a credential's descriptive fields could not be read (#952). Recorded
/// beside EXTRACTION_FAILED so a later run can tell what is worth retrying:
/// a code fix for a bad envelope or bridge, a restored key for a decrypt.
enum CredentialDetailsError {
  UNREADABLE_ENVELOPE
  BRIDGE_ERROR
  DECRYPT_FAILED
}

/// The UNTP core credential types, by the codes the API uses (#955). The
/// library stores a credential's type as this code whether it is the
/// recipient's declaration or what extraction read from the artefact, so the
/// two compare directly; the data-model bridge registry's full names
/// (DigitalProductPassport and so on) are one map away when a bridge is
/// looked up.
enum CoreCredentialType {
  DFR
  DCC
  DPP
  DTE
  DIA
}

/// Which child table a library record's origin-specific columns live in
/// (ADR-053 decisions 1 and 2): NATIVE for a credential this system issued
/// (Credential), EXTERNAL for one registered from a third party
/// (ExternalCredential).
enum LibraryRecordOrigin {
  NATIVE
  EXTERNAL
}

/// What a registered external credential's durable copy turned out to hold
/// (#955). Decides what the worker sends to the verifier and which checks can
/// apply. CREDENTIAL is a verifiable credential in a form this system can
/// read; today that is the W3C VCDM 2.0 enveloped (JOSE) form UNTP requires,
/// and recognising another form is a change to the classifier, not to this
/// enum. Only a CREDENTIAL is extracted and digest-checked. JSON_OBJECT is any
/// other JSON object; OPAQUE is everything else (HTML, an empty body, a JSON
/// array or primitive).
enum ExternalContentKind {
  CREDENTIAL
  JSON_OBJECT
  OPAQUE
}

/// Whether one check run concluded (#955, ADR-053 decision 3). PENDING
/// means the in-request work settled and only the asynchronous verifier call
/// is outstanding; COMPLETE means the checks reached a conclusion either way,
/// so a forged or revoked credential is COMPLETE; FAILED means an operational
/// prerequisite stopped them from concluding, with the reason in failureCode.
enum CheckRunState {
  PENDING
  COMPLETE
  FAILED
}

/// Outcome of one check within a run. NOT_RUN covers both "did not apply"
/// and "did not execute", so an all-NOT_RUN blocking set can never read as a
/// pass.
enum CheckResult {
  PASS
  FAIL
  NOT_RUN
}

/// Why a FAILED check run could not conclude (#955). The wire contract's
/// closed set; STORED_COPY_UNAVAILABLE is emitted when a durable copy this
/// system believed it held cannot be read back or no longer matches its digest.
enum CheckRunFailureCode {
  RETRIEVAL_FAILED
  DECRYPTION_REQUIRED
  DECRYPTION_FAILED
  STORAGE_FAILED
  VERIFICATION_UNAVAILABLE
  STORED_COPY_UNAVAILABLE
}

enum ServiceType {
  IDR
  STORAGE
  VC
}

enum AdapterType {
  VCKIT
  PYX_IDR
  UNCEFACT_STORAGE
}

enum ProductLevel {
  MODEL
  BATCH
  ITEM
}

enum RenderMethodType {
  RenderTemplate2024
  WebRenderingTemplate2022
}

/**
 * Auth.js + Prisma adapter tables for OAuth + JWT sessions
 */
model User {
  id             String    @id @default(cuid())
  authProviderId String?   @unique
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  tenantId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  id_token          String?
  token_type        String?
  scope             String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Tenant {
  id                 String   @id @default(cuid())
  name               String
  externalIdpGroupId String?  @unique
  primaryColor       String?
  secondaryColor     String?
  logo               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users               User[]
  dids                Did[]
  serviceInstances    ServiceInstance[]
  registrars          Registrar[]
  schemes             IdentifierScheme[]
  identifiers         Identifier[]
  linkRegistrations   LinkRegistration[]
  organisations       OrganisationEntity[]
  facilities          Facility[]
  products            Product[]
  libraryRecords      LibraryRecord[]
  credentials         Credential[]
  externalCredentials ExternalCredential[]
  idempotencyKeys     IdempotencyKey[]
  dataModels          DataModel[]
  renderTemplates     RenderTemplate[]
  conformitySchemes   ConformityScheme[]

  @@map("Tenant")
}

/**
 * A library record (ADR-053 decision 1): identity and the fields that are
 * the same for both origins by construction, the descriptive fields
 * extraction reads from the signed artefact (decision 5). Each record has
 * exactly one child row, Credential or ExternalCredential, keyed by this id
 * and matching its origin and tenant. The write paths create both in one
 * transaction; the migration adds deferred constraint triggers that refuse
 * to commit a parent with no child, or a child whose parent still exists at
 * commit, so a child never outlives its parent. Deleting the parent cascades
 * to the child. The children's composite foreign key pins origin and tenant.
 */
model LibraryRecord {
  id       String              @id @default(cuid())
  tenantId String
  origin   LibraryRecordOrigin

  /// Descriptive fields read from the signed artefact (#952, decision 5).
  /// Null while detailsStatus is not EXTRACTED, and null for an external
  /// record whose artefact has not been read yet.
  name                 String?
  issuerName           String?
  issuerDid            String?
  subjectName          String?
  subjectId            String?
  validFrom            DateTime?
  validUntil           DateTime?
  /// The type the record asserts, an extension's own name when it is one
  /// (decision 8). For a native record it is the registered data model
  /// issuance resolved; for an external record it is read from the artefact.
  credentialType       String?
  /// The core kind the type resolves to (decision 8), derived once at write
  /// time: a native record's data model core parent, or the one core name an
  /// external record's type set contains. Null when nothing names one. For a
  /// record extracted from an artefact, a type set naming two core kinds also
  /// leaves this null and records EXTRACTION_FAILED with BRIDGE_ERROR.
  coreCredentialType   CoreCredentialType?
  /// Spec version the data-model bridge was resolved with (#953). For an
  /// extension this is the parent version.
  coreDataModelVersion String?
  detailsStatus        CredentialDetailsStatus @default(EXTRACTION_PENDING)
  detailsError         CredentialDetailsError?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credential         Credential?
  externalCredential ExternalCredential?
  checkRuns          CheckRun[]
  idempotencyKey     IdempotencyKey?

  /// Targets for the children's and the claim's composite foreign keys, so a
  /// child can only attach to a parent of its own tenant and origin, and a
  /// claim only to a record of its own tenant. Redundant with the primary
  /// key, which Postgres requires spelt out to reference.
  @@unique([id, tenantId])
  @@unique([id, tenantId, origin])
  @@index([tenantId])
  @@index([tenantId, origin])
  @@index([tenantId, coreCredentialType])
  @@index([tenantId, issuerDid])
}

/**
 * A credential this system issued: the native child of a LibraryRecord
 * (ADR-053 decision 2), sharing its id. Holds what only a native credential
 * has: where the signed artefact is stored, the key that opens it,
 * publication state and the master-data links.
 */
model Credential {
  id              String              @id
  tenantId        String
  /// Always NATIVE (a database CHECK pins it); part of the composite foreign
  /// key so this child can only attach to a NATIVE parent of its own tenant.
  origin          LibraryRecordOrigin @default(NATIVE)
  storageUri      String
  digestMultibase String
  /// @encryptedAtRest The storage service's key for the private copy, protected
  /// by protectDecryptionKey (#697). Rows written before that may hold it in
  /// plaintext until backfill:decryption-keys wraps them.
  decryptionKey   String?
  isPublished     Boolean             @default(false)
  organisationId  String?
  facilityId      String?
  productId       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  record       LibraryRecord       @relation(fields: [id, tenantId, origin], references: [id, tenantId, origin], onDelete: Cascade)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisation OrganisationEntity? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  facility     Facility?           @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  product      Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Prisma requires the defining side of a one-to-one relation to be unique
  /// over the relation's fields; the primary key already makes it so.
  @@unique([id, tenantId, origin])
  @@index([organisationId])
  @@index([facilityId])
  @@index([productId])
  @@index([tenantId])
}

/**
 * Per-tenant idempotency keys (#954, ADR-051). A claim is scoped by tenant,
 * operation and key. Cascade on the record frees the key that produced it,
 * so a later reuse of that operation's key proceeds as a first request.
 * `finalisedAt` is set once the original response has been recorded for
 * replay; a row with a record and no timestamp is still in flight.
 */
model IdempotencyKey {
  id               String               @id @default(cuid())
  tenantId         String
  operation        IdempotencyOperation
  key              String
  bodyDigest       String
  /// The library record the claim's request produced: a native credential
  /// for CREDENTIAL_ISSUE, an external one for LIBRARY_REGISTER (#955). Null
  /// is an empty claim. The composite foreign key pins the record to the
  /// claim's tenant; cascade frees the key when the record is deleted.
  recordId         String?              @unique
  /// Set with recordId. Ages a recorded-but-unfinalised row. An empty claim ages from createdAt (#954).
  resultRecordedAt DateTime?
  /// @encryptedAtRest AES-256-GCM envelope of the response a later retry
  /// replays. The same protection Credential.decryptionKey uses, so a database
  /// reader cannot recover a replayed response (#954, ADR-051).
  responseBody     String?
  createdAt        DateTime             @default(now())
  finalisedAt      DateTime?

  record LibraryRecord? @relation(fields: [recordId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, operation, key])
  @@unique([recordId, tenantId])
}

/**
 * A credential received from a third party: the external child of a
 * LibraryRecord (#955, ADR-053 decision 2, ADR-055), sharing its id. Holds
 * what only a received credential has: where it came from, what the fetch
 * observed, the durable copy's coordinates, and the recipient's annotations.
 * Custody (ADR-055): a supplier's key is never stored. decryptionKey is the
 * key our own storage service returned for the protected copy, encrypted at
 * rest exactly like Credential.decryptionKey; null means no openable copy yet.
 */
model ExternalCredential {
  id           String               @id
  tenantId     String
  /// Always EXTERNAL (a database CHECK pins it); part of the composite
  /// foreign key so this child can only attach to an EXTERNAL parent of its
  /// own tenant.
  origin       LibraryRecordOrigin  @default(EXTERNAL)
  /// Canonical WHATWG href the credential was fetched from. Nullable because
  /// the record contract admits later intake modes with no URL; the v1
  /// register route requires one.
  sourceUrl    String?
  /// Multibase digest of the raw bytes as fetched, before any decrypt. Null
  /// until a fetch succeeded.
  sourceDigest String?
  /// Whether the fetched body was an encrypted envelope. Null until a body
  /// was observed, so a failed fetch never claims to have seen one.
  encrypted    Boolean?
  contentKind  ExternalContentKind?

  /// The durable copy, all null until one was stored. The storage instance,
  /// object id and bucket are recorded so a later read or deletion targets the
  /// service that holds the copy. storageServiceInstanceId is not a foreign
  /// key, matching Credential, which carries no reference to its instance.
  storageUri               String?
  storageDigestMultibase   String?
  storageServiceInstanceId String?
  storageExternalId        String?
  storageBucket            String?
  /// @encryptedAtRest AES-256-GCM envelope, under DATA_ENCRYPTION_KEY, of the
  /// receiver-side key our own storage service returned for the durable copy
  /// (ADR-055 decision 2). Never a supplier's key, which is used and
  /// forgotten. Null while no openable copy exists.
  decryptionKey            String?

  /// Recipient-asserted annotations (#955, #959). annotationVersion is the
  /// concurrency token PATCH compares against; it starts at 1.
  displayName            String
  declaredCredentialType CoreCredentialType
  dateReceived           DateTime?          @db.Date
  notes                  String?
  annotationVersion      Int                @default(1)
  /// A key was supplied but the source turned out to be plaintext, so it was
  /// never applied; recorded rather than silently discarded. Set by a
  /// registration or a re-verification and never cleared, so it reads as
  /// "at least one call supplied a key that was not needed".
  decryptionKeyUnused    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  record LibraryRecord @relation(fields: [id, tenantId, origin], references: [id, tenantId, origin], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId, origin])
  @@index([tenantId])
  @@index([tenantId, declaredCredentialType])
}

/**
 * One run of the seven checks over a library record's artefact (#955; the
 * checks are the coverage listed under ADR-055 decision 7, the generation
 * row ADR-053 decision 3):
 * acquisition (retrieval, decryption), custody integrity
 * (digest), verification proper (proof, status, temporal) and validation
 * (schemaConformance). The wire calls a run a "verification generation"; the
 * table is named for what it holds, since only three of the seven checks are
 * verification in the credential sense. A run belongs to exactly one record
 * through one foreign key to the parent. Runs are only ever added, so a stale
 * result can never overwrite a newer one.
 * summary is not a column: it is derived from state and the blocking checks
 * by one function, per the contract's derivation rule.
 * Two constraints live in the migration as raw SQL: generation is at least
 * 1, and a record has at most one PENDING run (a partial unique index), which
 * is what lets a request that arrives while a run is pending join it rather
 * than race it (#957).
 */
model CheckRun {
  id         String        @id @default(cuid())
  recordId   String
  /// The record's tenant, carried on the run so a read is scoped by the
  /// same key the record is, never by call-site convention.
  tenantId   String
  /// The contract's `verification.generation`: numbered per record from 1,
  /// and run N supersedes run N-1. A native record's generation 1 is the
  /// issuance assertion (ADR-053 decision 4), synthesised at read time from
  /// the Credential row and never stored, so a native record's first row here
  /// is generation 2, written by re-verify. An external record's generation 1
  /// is a real row, written at register.
  generation Int
  state      CheckRunState

  retrieval         CheckResult @default(NOT_RUN)
  decryption        CheckResult @default(NOT_RUN)
  digest            CheckResult @default(NOT_RUN)
  proof             CheckResult @default(NOT_RUN)
  status            CheckResult @default(NOT_RUN)
  temporal          CheckResult @default(NOT_RUN)
  schemaConformance CheckResult @default(NOT_RUN)

  failureCode      CheckRunFailureCode?
  failureMessage   String?
  failureRetryable Boolean?

  requestedAt    DateTime  @default(now())
  completedAt    DateTime?
  /// When the verify job for this run was last enqueued. The column and its
  /// index exist for a reconciliation sweep that will re-enqueue PENDING rows
  /// whose marker is stale; no sweep runs yet. Written from the application
  /// clock, like requestedAt on the same row, so the sweep computes its
  /// cutoff in the application too rather than in SQL.
  lastEnqueuedAt DateTime?

  record LibraryRecord @relation(fields: [recordId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([recordId, generation])
  @@index([state, lastEnqueuedAt])
}

/**
 * DID records scoped to organisations (tenants).
 * Supports three tiers: DEFAULT (system-wide), MANAGED, and SELF_MANAGED.
 */
model Did {
  id          String    @id @default(cuid())
  tenantId    String
  did         String    @unique
  type        DidType
  method      DidMethod @default(DID_WEB)
  name        String
  description String?
  keyId       String
  status      DidStatus @default(UNVERIFIED)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  serviceInstanceId String?
  serviceInstance   ServiceInstance? @relation(fields: [serviceInstanceId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/**
 * Registered service instances scoped to organisations (tenants).
 * Each instance stores AES-256-GCM encrypted configuration for its adapter.
 */
model ServiceInstance {
  id          String      @id @default(cuid())
  tenantId    String
  serviceType ServiceType
  adapterType AdapterType
  name        String
  description String?
  /// @encryptedAtRest AES-256-GCM envelope of the adapter configuration JSON.
  config      String
  isPrimary   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dids       Did[]
  registrars Registrar[]        @relation("RegistrarIdr")
  schemes    IdentifierScheme[] @relation("SchemeIdr")

  @@index([tenantId, serviceType])
}

/**
 * Provenance of a seedable row: created by the core seed (`prisma/seed.ts`),
 * managed by the custom seed manifest (`seed.yaml`), or created through the
 * API/UI. The custom-seed removal phase only ever deletes `CUSTOM_SEED`
 * rows and refuses to claim `CORE_SEED` rows. A system-tenant `USER` row
 * whose id matches a manifest entry is adopted by the upsert (stamped
 * `CUSTOM_SEED`), which is how pre-provenance custom-seed rows come back
 * under manifest management. Mirrors `ConformitySchemeSource` for CVC tables.
 */
enum RecordSource {
  CORE_SEED
  CUSTOM_SEED
  USER
}

/**
 * Registrars are organisations that operate identifier schemes.
 * Scoped to tenants, with system defaults available to all.
 */
model Registrar {
  id                   String       @id @default(cuid())
  tenantId             String
  name                 String
  namespace            String
  url                  String?
  idrServiceInstanceId String?
  source               RecordSource @default(USER)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  idrServiceInstance ServiceInstance?   @relation("RegistrarIdr", fields: [idrServiceInstanceId], references: [id], onDelete: SetNull)
  schemes            IdentifierScheme[]

  @@index([tenantId])
}

/**
 * Identifier schemes define a type of identifier with validation rules.
 * Each scheme belongs to a registrar and may have qualifier definitions.
 */
model IdentifierScheme {
  id                   String       @id @default(cuid())
  tenantId             String
  registrarId          String
  name                 String
  primaryKey           String
  validationPattern    String
  linkTemplate         String // ISO 18975 link template, e.g. "/{primaryKey}/{value}"
  idrServiceInstanceId String?
  source               RecordSource @default(USER)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrar          Registrar         @relation(fields: [registrarId], references: [id], onDelete: Cascade)
  idrServiceInstance ServiceInstance?  @relation("SchemeIdr", fields: [idrServiceInstanceId], references: [id], onDelete: SetNull)
  qualifiers         SchemeQualifier[]
  identifiers        Identifier[]

  @@unique([registrarId, primaryKey, tenantId])
  @@index([tenantId])
}

/**
 * Qualifier definitions for identifier schemes (e.g. batch number, serial number).
 * Each qualifier belongs to exactly one scheme.
 */
model SchemeQualifier {
  id                String       @id @default(cuid())
  schemeId          String
  key               String
  description       String
  validationPattern String
  order             Int          @default(0) // Qualifier precedence in URI (ascending)
  source            RecordSource @default(USER)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  scheme IdentifierScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, key])
}

/**
 * Actual identifier values validated against their scheme's pattern.
 * Scoped to a single tenant (not shared with system defaults).
 */
model Identifier {
  id        String   @id @default(cuid())
  tenantId  String
  schemeId  String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheme            IdentifierScheme   @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  linkRegistrations LinkRegistration[]

  organisationPrimary     OrganisationEntity?               @relation("OrganisationPrimaryIdentifier")
  facilityPrimary         Facility?                         @relation("FacilityPrimaryIdentifier")
  productPrimary          Product?                          @relation("ProductPrimaryIdentifier")
  organisationSecondaries OrganisationSecondaryIdentifier[] @relation("OrganisationSecondaryIdentifiers")
  facilitySecondaries     FacilitySecondaryIdentifier[]     @relation("FacilitySecondaryIdentifiers")
  productSecondaries      ProductSecondaryIdentifier[]      @relation("ProductSecondaryIdentifiers")

  @@unique([schemeId, value, tenantId])
  @@index([tenantId])
}

/**
 * Audit trail for links published to IDR services.
 * Each record maps a local identifier to an IDR-assigned link.
 */
model LinkRegistration {
  id            String   @id @default(cuid())
  tenantId      String
  identifierId  String
  idrLinkId     String
  linkType      String
  targetUrl     String
  mimeType      String
  resolverUri   String
  qualifierPath String?
  publishedAt   DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identifier Identifier @relation(fields: [identifierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([identifierId])
}

/**
 * Organisation entities representing trading partners, suppliers, or self.
 * Distinct from the Tenant model which represents auth tenants.
 */
model OrganisationEntity {
  id                  String   @id @default(cuid())
  tenantId            String
  name                String
  description         String?
  location            Json?
  primaryIdentifierId String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryIdentifier Identifier? @relation("OrganisationPrimaryIdentifier", fields: [primaryIdentifierId], references: [id], onDelete: SetNull)

  secondaryIdentifiers OrganisationSecondaryIdentifier[]
  credentials          Credential[]
  facilities           Facility[]
  products             Product[]

  @@index([tenantId])
}

/**
 * Physical locations (factories, farms, warehouses) operated by organisations.
 */
model Facility {
  id                      String   @id @default(cuid())
  tenantId                String
  name                    String
  description             String?
  location                Json?
  operatingOrganisationId String?
  primaryIdentifierId     String?  @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operatingOrganisation OrganisationEntity? @relation(fields: [operatingOrganisationId], references: [id], onDelete: SetNull)
  primaryIdentifier     Identifier?         @relation("FacilityPrimaryIdentifier", fields: [primaryIdentifierId], references: [id], onDelete: SetNull)

  secondaryIdentifiers FacilitySecondaryIdentifier[]
  credentials          Credential[]
  products             Product[]

  @@index([tenantId])
}

/**
 * Products at three levels per UNTP spec: Model, Batch, Serialised Item.
 */
model Product {
  id                       String       @id @default(cuid())
  tenantId                 String
  name                     String
  description              String?
  level                    ProductLevel
  batchNumber              String?
  serialNumber             String?
  parentId                 String?
  producedByOrganisationId String?
  manufacturingFacilityId  String?
  primaryIdentifierId      String?      @unique
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent                 Product?            @relation("ProductHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children               Product[]           @relation("ProductHierarchy")
  producedByOrganisation OrganisationEntity? @relation(fields: [producedByOrganisationId], references: [id], onDelete: SetNull)
  manufacturingFacility  Facility?           @relation(fields: [manufacturingFacilityId], references: [id], onDelete: SetNull)
  primaryIdentifier      Identifier?         @relation("ProductPrimaryIdentifier", fields: [primaryIdentifierId], references: [id], onDelete: SetNull)

  secondaryIdentifiers ProductSecondaryIdentifier[]
  credentials          Credential[]

  @@index([tenantId])
  @@index([parentId])
}

model OrganisationSecondaryIdentifier {
  organisationId String
  identifierId   String

  organisation OrganisationEntity @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  identifier   Identifier         @relation("OrganisationSecondaryIdentifiers", fields: [identifierId], references: [id], onDelete: Cascade)

  @@id([organisationId, identifierId])
}

model FacilitySecondaryIdentifier {
  facilityId   String
  identifierId String

  facility   Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  identifier Identifier @relation("FacilitySecondaryIdentifiers", fields: [identifierId], references: [id], onDelete: Cascade)

  @@id([facilityId, identifierId])
}

model ProductSecondaryIdentifier {
  productId    String
  identifierId String

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  identifier Identifier @relation("ProductSecondaryIdentifiers", fields: [identifierId], references: [id], onDelete: Cascade)

  @@id([productId, identifierId])
}

/**
 * Data model configuration for both core UNTP types and tenant extensions.
 * Stores schema URLs, context URLs, and version information.
 * Extensions reference a parent config via the self-relation.
 */
model DataModel {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  credentialType String
  version        String

  isExtension    Boolean     @default(true)
  parentConfigId String?
  parentConfig   DataModel?  @relation("ExtensionParent", fields: [parentConfigId], references: [id], onDelete: Cascade)
  extensions     DataModel[] @relation("ExtensionParent")

  schemaUrl  String
  contextUrl String
  websiteUrl String?
  source     RecordSource @default(USER)

  renderTemplates RenderTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([credentialType, version, tenantId, isExtension, name])
}

/**
 * Render template references for credential types.
 * Stores storage URLs and hashes, with an isDefault flag for tenant default selection.
 */
model RenderTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  dataModelId String
  dataModel   DataModel @relation(fields: [dataModelId], references: [id], onDelete: Cascade)

  name                     String
  storageUrl               String
  digestMultibase          String
  isDefault                Boolean          @default(false)
  renderMethodType         RenderMethodType
  storageServiceInstanceId String?
  storageExternalId        String?
  storageBucket            String?
  storageContentType       String?
  inline                   Boolean?
  mediaType                String?
  mediaQuery               String?
  source                   RecordSource     @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, dataModelId])
}

// ── CVC (Conformity Vocabulary Catalogue) models ────────────────────────────

enum ConformitySchemeSource {
  UNTP
  SYSTEM_SEED
  TENANT_IMPORTED
}

/**
 * How a seeded (`SYSTEM_SEED`) conformity scheme entered the seed manifest:
 * from a fetchable URL, or from a local file whose document id doubles as the
 * row's `sourceUrl`. The periodic refresh only re-fetches `URL` rows; `FILE`
 * rows refresh at boot from the mounted file. Null means the row predates the
 * marker; the refresh treats a null with an http(s) `sourceUrl` as `URL`.
 */
enum SeedEntryKind {
  URL
  FILE
}

enum ConformityFetchStatus {
  SUCCESS
  FETCH_FAILED
  TOO_LARGE
  INVALID_JSON
  SCHEMA_INVALID
  JSONLD_EXPANSION_FAILED
  PARSE_FAILED
  DIGEST_FAILED
}

/**
 * A conformity scheme published by a scheme owner.
 * Inlines versioned profiles and criteria.
 */
model ConformityScheme {
  id                 String                 @id @default(cuid())
  canonicalId        String
  name               String
  description        String?
  documentation      String?
  ownerCanonicalId   String?
  ownerName          String?
  specVersion        String
  source             ConformitySchemeSource
  sourceUrl          String
  etag               String?
  lastModifiedHeader String?
  bodyDigest         String?
  lastFetchedAt      DateTime?
  lastSuccessAt      DateTime?
  lastFetchStatus    ConformityFetchStatus
  seedEntryKind      SeedEntryKind?
  rawDocument        Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profiles           ConformityProfile[]

  @@unique([canonicalId, tenantId])
  @@unique([sourceUrl, tenantId])
  @@index([tenantId])
  @@index([source])
}

/**
 * A versioned assessment profile within a conformity scheme.
 */
model ConformityProfile {
  id            String                       @id @default(cuid())
  canonicalId   String
  name          String
  version       String
  status        String
  description   String?
  documentation String?
  validFrom     String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  tenantId      String
  schemeId      String
  scheme        ConformityScheme             @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  criteria      ConformityProfileCriterion[]

  @@unique([canonicalId, tenantId])
  @@index([schemeId])
}

/**
 * A versioned auditable requirement, referenced from one or more profiles.
 * Topics are stored as a JSON array of `{ canonicalId, name?, definition? }` objects.
 */
model ConformityCriterion {
  id            String                       @id @default(cuid())
  canonicalId   String
  name          String
  version       String
  status        String
  description   String?
  documentation String?
  topics        Json?
  tags          String[]
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  tenantId      String
  profiles      ConformityProfileCriterion[]

  @@unique([canonicalId, tenantId])
  @@index([tenantId])
}

/**
 * Join table linking profiles to criteria.
 */
model ConformityProfileCriterion {
  id          String              @id @default(cuid())
  profileId   String
  criterionId String
  profile     ConformityProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  criterion   ConformityCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([profileId, criterionId])
  @@index([criterionId])
}
